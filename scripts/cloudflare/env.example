# Copy to a file outside Git or export these values in your shell.
# Never commit real values.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The provisioning script discovers these automatically. GitHub Actions uses
# the same names as repository variables.
EBC_DASHBOARD_D1_ID=
EBC_EVENTS_D1_ID=

# Shared worker-to-worker authentication. If omitted, configure-secrets.sh
# generates a new value and installs it on dashboard, concierge, and voice.
INTERNAL_CALL_SECRET=

# EBC-specific channel identity. Shared provider credentials come from the
# account Secrets Store profile declared in each Wrangler configuration.
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=

# EBC-specific verified sender
FROM_EMAIL=

# DocuSign's JWT RSA key is larger than the Secrets Store per-secret limit and
# remains a per-worker secret. The other DocuSign IDs use the shared profile.
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_CONSENT_REDIRECT_URI=

# Copy to a file outside Git or export these values in your shell.
# Never commit real values.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The provisioning script discovers these automatically. GitHub Actions uses
# the same names as repository variables.
EBC_DASHBOARD_D1_ID=
EBC_EVENTS_D1_ID=

# Shared worker-to-worker authentication. If omitted, configure-secrets.sh
# generates a new value and installs it on dashboard, concierge, and voice.
INTERNAL_CALL_SECRET=

# Voice and SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
EILA_RUNTIME_TOKEN=
OPENAI_API_KEY=

# Email
RESEND_API_KEY=
FROM_EMAIL=

# Zoom and LiveKit
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# DocuSign
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_CONSENT_REDIRECT_URI=
